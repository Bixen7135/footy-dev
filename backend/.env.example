# Backend
FOOTY_APP_NAME=FOOTY API
FOOTY_DEBUG=false
FOOTY_DATABASE_URL=sqlite:///./footy.db
FOOTY_JWT_SECRET=change-me
FOOTY_JWT_ALGORITHM=HS256
FOOTY_ACCESS_TOKEN_MINUTES=30
FOOTY_REFRESH_TOKEN_MINUTES=10080
FOOTY_CORS_ORIGINS=http://localhost:3000
FOOTY_ACCESS_COOKIE_NAME=access_token
FOOTY_REFRESH_COOKIE_NAME=refresh_token
FOOTY_ANONYMOUS_COOKIE_NAME=anonymous_id
FOOTY_COOKIE_SECURE=false
FOOTY_COOKIE_SAMESITE=lax
FOOTY_COOKIE_PATH=/
FOOTY_UPLOAD_DIR=./uploads
FOOTY_MAX_UPLOAD_BYTES=10485760
FOOTY_ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,image/gif
FOOTY_EXPORTS_DIR=../exports
FOOTY_BOOTSTRAP_REPORT_DIR=../runbooks/reports
FOOTY_RANKER_ARTIFACTS_DIR=./artifacts/ranker
FOOTY_RANKER_MODEL_FILENAME=model.txt
FOOTY_RANKER_META_FILENAME=meta.json
FOOTY_RANKER_DATASET_FILENAME=training_dataset.jsonl
FOOTY_RANKER_MIN_ROWS=100

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
